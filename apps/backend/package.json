{
  "name": "@wallet/backend",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "build:lambda": "nest build && rm -rf ../../.deploy/backend && esbuild dist/lambda.js --bundle --platform=node --target=node22 --format=cjs --outfile=../../.deploy/backend/lambda.js --external:@nestjs/microservices --external:@nestjs/microservices/microservices-module --external:@nestjs/websockets --external:@nestjs/websockets/socket-module --external:cache-manager",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "dependencies": {
    "@codegenie/serverless-express": "^5.0.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1"
  }
}
